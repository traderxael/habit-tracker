# Puerto del servidor backend
PORT=3001

# Base de datos libSQL / Turso.
# Local o Docker: usa un archivo (libSQL es compatible con SQLite).
DATABASE_URL=file:./data.sqlite
# En producción (Vercel) define en su lugar:
#   TURSO_DATABASE_URL=libsql://<tu-db>.turso.io
#   TURSO_AUTH_TOKEN=<token de Turso>
# TURSO_DATABASE_URL tiene prioridad sobre DATABASE_URL.

# Secreto para firmar los JWT (obligatorio y único en producción)
JWT_SECRET=dev-secret-change-me
# Duración del token de sesión
TOKEN_TTL=7d
